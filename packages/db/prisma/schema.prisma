// CodeGate data model — cf. cahier des charges §13.2
// PostgreSQL. Enums mirror packages/shared/src/enums.ts.

generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel-openssl-3.0.x = Vercel's Node runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  owner
  admin
  security_manager
  developer
  auditor
  viewer
}

enum ScmProvider {
  github
  gitlab
}

enum ProtectionLevel {
  observe
  warn
  block
}

enum PullRequestStatus {
  pending
  analyzing
  passed
  warning
  blocked
  escalated
}

enum Severity {
  info
  low
  medium
  high
  critical
}

enum FindingType {
  secret
  dependency
  sast
  config
  auth
  prompt_injection
}

enum FindingStatus {
  open
  acknowledged
  resolved
  false_positive
}

enum DependencyRisk {
  low
  medium
  high
  critical
}

enum PolicyAction {
  allow
  warn
  block
  require_approval
}

enum ActorType {
  user
  ai_agent
  system
}

enum AgentPermission {
  read_repo
  modify_file
  install_dependency
  run_shell
  network_access
  modify_secrets
  deploy_production
  delete_files
}

enum AgentDecision {
  allow
  deny
  require_approval
}

enum DeployDecision {
  authorized
  warning
  blocked
  requires_approval
}

// ─── Core tenancy ───────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  plan      String   @default("free")
  region    String   @default("eu")
  createdAt DateTime @default(now())

  users            User[]
  repositories     Repository[]
  policies         Policy[]
  auditEvents      AuditEvent[]
  installations    GithubInstallation[]
  linearConnection LinearConnection?
  slackConnection  SlackConnection?
  gitlabConnection GitlabConnection?
  jiraConnection   JiraConnection?
  scimToken        ScimToken?
  samlConnection   SamlConnection?
  agentPolicies    AgentPolicy[]
  servers          Server[]
  bruteforcePolicies BruteForcePolicy[]
  bruteforceTargets  BruteForceTarget[]
  backupJobs         BackupJob[]
  approvalRequests   ApprovalRequest[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String   @unique
  name           String
  passwordHash   String
  role           Role     @default(developer)
  // Active flag for SCIM provisioning/deprovisioning (cahier §12.2 P3).
  active         Boolean  @default(true)
  mfaEnabled     Boolean  @default(false)
  // TOTP secret, encrypted at rest (AES-256-GCM). Null until MFA is set up.
  mfaSecret      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("users")
}

// ─── Repositories & pull requests ───────────────────────

model Repository {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  provider        ScmProvider
  externalId      String
  name            String
  defaultBranch   String          @default("main")
  protectionLevel ProtectionLevel @default(observe)
  // GitHub App installation that grants access to this repo (for token minting).
  installationId  BigInt?
  createdAt       DateTime        @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pullRequests  PullRequest[]
  policies      Policy[]
  agentPolicies AgentPolicy[]
  deployChecks  DeployCheck[]
  suppressions  FindingSuppression[]

  @@unique([provider, externalId])
  @@index([organizationId])
  @@map("repositories")
}

model PullRequest {
  id           String            @id @default(uuid()) @db.Uuid
  repositoryId String            @db.Uuid
  externalId   String
  number       Int
  title        String
  author       String
  aiGenerated  Boolean           @default(false)
  // Head commit SHA — required to attach a GitHub Check Run.
  headSha      String?
  riskScore    Int?
  status       PullRequestStatus @default(pending)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  repository        Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings          Finding[]
  dependencies      Dependency[]
  secretFindings    SecretFinding[]
  remediationIssues RemediationIssue[]

  @@unique([repositoryId, externalId])
  @@index([repositoryId])
  @@map("pull_requests")
}

// ─── Findings ───────────────────────────────────────────

model Finding {
  id            String        @id @default(uuid()) @db.Uuid
  pullRequestId String        @db.Uuid
  type          FindingType
  severity      Severity
  title         String
  description   String
  filePath      String?
  line          Int?
  ruleId        String?
  remediation   String?
  status        FindingStatus @default(open)
  createdAt     DateTime      @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@map("findings")
}

model Dependency {
  id            String         @id @default(uuid()) @db.Uuid
  pullRequestId String         @db.Uuid
  ecosystem     String
  name          String
  version       String
  trustScore    Int?
  riskLevel     DependencyRisk @default(low)
  reason        String?
  createdAt     DateTime       @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@map("dependencies")
}

model SecretFinding {
  id            String        @id @default(uuid()) @db.Uuid
  pullRequestId String        @db.Uuid
  secretType    String
  location      String
  maskedPreview String
  severity      Severity      @default(high)
  status        FindingStatus @default(open)
  revokedAt     DateTime?
  createdAt     DateTime      @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@map("secret_findings")
}

/// Record of a pre-deployment security decision (cahier §5.5).
model DeployCheck {
  id            String         @id @default(uuid()) @db.Uuid
  repositoryId  String         @db.Uuid
  externalId    String
  provider      String         @default("vercel")
  target        String?
  commitSha     String?
  decision      DeployDecision
  reason        String
  createdAt     DateTime       @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([repositoryId])
  @@map("deploy_checks")
}

enum InfraCategory {
  ports
  ssh
  firewall
  bruteforce
  docker
  updates
  backups
  tls
}

/// A VPS / server monitored by Infra Shield (extension §3). Ownership is
/// proven by the agent running on it with a per-server token — CodeGate never
/// scans a host from the outside.
model Server {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  provider       String?
  environment    String    @default("production")
  // sha256 of the agent token; the token itself is shown once at creation.
  agentTokenHash String    @unique
  hostname       String?
  os             String?
  agentVersion   String?
  securityScore  Int?
  // Last normalized facts reported by the agent (no secrets — see agent).
  lastReport     Json?
  lastReportAt   DateTime?
  // Set when a "silent agent" alert was sent; cleared by the next report.
  silentAlertedAt DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  findings     ServerFinding[]
  backupJobs   BackupJob[]

  @@index([organizationId])
  @@map("servers")
}

/// One failed Infra Shield control on a server; replaced at every report.
model ServerFinding {
  id             String        @id @default(uuid()) @db.Uuid
  serverId       String        @db.Uuid
  category       InfraCategory
  checkId        String
  severity       Severity
  title          String
  detail         String
  recommendation String
  createdAt      DateTime      @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@map("server_findings")
}

/// Failure counter + progressive lockout for CodeGate's own auth endpoints
/// (BruteForce Shield §4.4). Keyed per account and per IP so a distributed
/// attack on one account is still caught (OWASP).
model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  lockouts    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@map("auth_throttles")
}

/// Expected anti brute force behaviour for one endpoint of the customer's app
/// (extension §4.7). Tests are graded against it.
model BruteForcePolicy {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  endpoint       String
  maxAttempts    Int
  windowSeconds  Int
  lockoutSeconds Int
  strategy       String   @default("progressive")
  applyTo        String[] @default(["ip", "account"])
  captchaAfter   Int?
  alertAfter     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, endpoint])
  @@map("bruteforce_policies")
}

/// An application origin the organization proved it controls (DNS TXT or
/// /.well-known file). No test ever runs against an unverified target.
model BruteForceTarget {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @db.Uuid
  name              String
  origin            String
  environment       String    @default("staging")
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tests        BruteForceTest[]

  @@unique([organizationId, origin])
  @@map("bruteforce_targets")
}

/// Result of one authorized, low-volume brute force test (US03).
model BruteForceTest {
  id           String   @id @default(uuid()) @db.Uuid
  targetId     String   @db.Uuid
  testType     String
  endpoint     String
  attempts     Int
  blockedAfter Int?
  scope        String?
  result       String
  summary      String
  evidence     Json
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  target BruteForceTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@map("bruteforce_tests")
}

/// A backup the organization expects to run (Backup Shield, extension §5).
/// The backup host reports each run with a per-job token; CodeGate never
/// reads, stores or restores the backup data itself.
model BackupJob {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  serverId       String?  @db.Uuid
  name           String
  type           String
  frequencyHours Int      @default(24)
  tokenHash      String   @unique
  // Set when a "missing backup" alert was sent; cleared by the next run.
  lateAlertedAt  DateTime?
  createdAt      DateTime @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  server       Server?             @relation(fields: [serverId], references: [id], onDelete: SetNull)
  runs         BackupRun[]
  restoreTests BackupRestoreTest[]

  @@index([organizationId])
  @@map("backup_jobs")
}

/// One reported backup execution and the protections it was produced with.
model BackupRun {
  id                  String    @id @default(uuid()) @db.Uuid
  jobId               String    @db.Uuid
  finishedAt          DateTime
  status              String
  sizeBytes           Float?
  durationSeconds     Int?
  sha256              String?
  encrypted           Boolean
  encryptionAlgorithm String?
  inTransit           String?
  keyLocation         String    @default("unknown")
  signed              Boolean   @default(false)
  storageProvider     String?
  storageLocation     String    @default("unknown")
  immutable           Boolean?
  versioning          Boolean?
  separateAccount     Boolean?
  retentionDays       Int?
  // Set when a later re-hash of the stored copy was compared to sha256.
  integrityCheckedAt  DateTime?
  integrityOk         Boolean?
  createdAt           DateTime  @default(now())

  job BackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, finishedAt])
  @@map("backup_runs")
}

/// Restore of a backup into a throwaway, isolated environment (US06).
model BackupRestoreTest {
  id              String   @id @default(uuid()) @db.Uuid
  jobId           String   @db.Uuid
  engine          String
  startedAt       DateTime
  completedAt     DateTime
  durationSeconds Int
  result          String
  restoredTables  Int?
  restoredRecords Float?
  detail          String?
  createdAt       DateTime @default(now())

  job BackupJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, completedAt])
  @@map("backup_restore_tests")
}

/// A finding a human marked as false positive (US02). Matched on later
/// re-analyses by fingerprint (rule + file, line-independent) so the verdict
/// survives new commits; suppressed findings no longer count in the score.
model FindingSuppression {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @db.Uuid
  fingerprint  String
  reason       String?
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, fingerprint])
  @@map("finding_suppressions")
}

/// A sensitive action waiting for a human decision (cahier §5.4, §5.5,
/// §10.5, US06): an AI agent action under `require_approval`, or a
/// deployment the Deploy Gate sent to human validation.
model ApprovalRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  repositoryId   String?   @db.Uuid
  kind           String
  title          String
  detail         Json
  // Identical pending requests are merged (an agent retrying the same action).
  dedupeKey      String
  status         String    @default("pending")
  requestedById  String?   @db.Uuid
  decidedById    String?   @db.Uuid
  decidedAt      DateTime?
  reason         String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([dedupeKey])
  @@map("approval_requests")
}

/// Webhook delivery ids already processed — idempotence when the API runs
/// without Redis (serverless, ANALYSIS_MODE=inline). cahier §13.4.
model WebhookDelivery {
  id        String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("webhook_deliveries")
}

/// Per-scope override of what an AI agent may do (cahier §5.4). A rule scoped
/// to a repository wins over an org-wide rule; absent any rule, secure
/// built-in defaults apply.
model AgentPolicy {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  repositoryId   String?         @db.Uuid
  permission     AgentPermission
  decision       AgentDecision
  allowlist      String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([organizationId, repositoryId, permission])
  @@index([organizationId])
  @@map("agent_policies")
}

/// Maps a GitHub App installation to a CodeGate organization. Created during
/// the connect flow; webhooks use it to attribute events to the right tenant.
model GithubInstallation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  installationId BigInt   @unique
  accountLogin   String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("github_installations")
}

/// Linear integration, one per organization. API key encrypted at rest.
model LinearConnection {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @db.Uuid
  apiKeyEncrypted String
  teamId          String
  // Signing secret of the Linear → CodeGate webhook (AES-256-GCM).
  webhookSecretEncrypted String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("linear_connections")
}

/// Slack incoming-webhook for incident alerts (cahier §9.5). URL encrypted.
model SlackConnection {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @unique @db.Uuid
  webhookUrlEncrypted String
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("slack_connections")
}

/// GitLab project connection (cahier §12.2 P3). Webhook authenticated by a
/// shared token; we store only its SHA-256 hash and look up the org by it.
model GitlabConnection {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  tokenHash      String   @unique
  // API access (read diffs, post statuses and MR notes): instance + token.
  baseUrl           String  @default("https://gitlab.com")
  apiTokenEncrypted String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("gitlab_connections")
}

/// SAML SSO connection (cahier §12.2 P3). The IdP cert is public (verification
/// material), so it is not encrypted.
model SamlConnection {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  idpEntityId    String
  idpSsoUrl      String
  idpCert        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("saml_connections")
}

/// SCIM 2.0 provisioning token (cahier §12.2 P3). Bearer token stored as a
/// SHA-256 hash; the org is resolved by it.
model ScimToken {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  tokenHash      String   @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("scim_tokens")
}

/// Jira Cloud connection (cahier §12.2 P3). API token encrypted at rest.
model JiraConnection {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @unique @db.Uuid
  baseUrl         String
  email           String
  apiTokenEncrypted String
  projectKey      String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("jira_connections")
}

/// Remediation ticket created in an external tracker for a PR (cahier §5.7).
model RemediationIssue {
  id            String   @id @default(uuid()) @db.Uuid
  pullRequestId String   @db.Uuid
  provider      String   @default("linear")
  externalId    String
  identifier    String?
  url           String?
  // Synced back from the tracker: open | done | canceled.
  status        String    @default("open")
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, provider])
  @@index([pullRequestId])
  @@map("remediation_issues")
}

// ─── Policy & audit ─────────────────────────────────────

model Policy {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  repositoryId       String?      @db.Uuid
  rule               String
  action             PolicyAction
  severityThreshold  Severity
  createdAt          DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository?  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("policies")
}

/// Immutable audit log — append-only (cahier §10.1, §13.2).
model AuditEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  actorType      ActorType
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}
