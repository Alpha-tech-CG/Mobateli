{
  "name": "@codegate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "worker": "tsx watch --env-file=../../.env src/worker.ts",
    "worker:start": "node --env-file=../../.env dist/worker.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:db:setup": "node ../../scripts/setup-test-db.mjs",
    "test:integration": "node --import tsx --test --test-force-exit \"src/**/*.itest.ts\"",
    "build:vercel": "node scripts/build-vercel.mjs",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@codegate/db": "workspace:*",
    "@codegate/shared": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^10.2.2",
    "@node-saml/node-saml": "^5.0.1",
    "@octokit/app": "^15.1.6",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
