# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000

# ─── Database ───────────────────────────────────────────
# Host port 5434 (see infra/docker/docker-compose.yml).
DATABASE_URL=postgresql://codegate:codegate@localhost:5434/codegate

# ─── Redis (cache + BullMQ queues) ──────────────────────
# Host port 6380 (see infra/docker/docker-compose.yml).
REDIS_URL=redis://localhost:6380

# ─── GitHub App ─────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# « Connecter GitHub » (liaison installation → organisation, vérifiée par OAuth) :
# slug public de l'app (github.com/apps/<slug>) + Client ID / Client secret de l'app.
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI engine (analysis / explanation) ─────────────────
ANTHROPIC_API_KEY=
AI_ENGINE_URL=http://localhost:8000

# ─── Scan engine (Rust) ─────────────────────────────────
SCAN_ENGINE_URL=http://localhost:9000
# Chemin du binaire codegate-scan, le moteur de taint natif (cargo build --release dans services/taint-engine).
# Sans lui (ni codegate-scan dans le PATH), l'analyse est signalée « partielle »
# (moteur Rust : binaire absent) dans le commentaire de PR et le dashboard.
CODEGATE_SCAN_BIN=
# Semgrep hors du PATH (ex. pip --user sous Windows) :
CODEGATE_SEMGREP_BIN=

# ─── Integrations ───────────────────────────────────────
LINEAR_API_KEY=
VERCEL_WEBHOOK_SECRET=

# ─── SSO (SAML) ─────────────────────────────────────────
# Base publique de l'API, utilisée pour construire les URLs SAML SP.
PUBLIC_API_URL=http://localhost:4000

# ─── Security ───────────────────────────────────────────
# 32-byte key, base64. Used for AES-256-GCM at-rest encryption.
ENCRYPTION_KEY=
JWT_SECRET=

# ─── Exécution & conformité ─────────────────────────────
# queue = Redis + worker (VPS) ; inline = sans Redis (Vercel / serverless)
ANALYSIS_MODE=queue
# MFA obligatoire pour owner/admin (§10.2)
MFA_REQUIRED_FOR_ADMINS=true
# Rétention (jours) : analyses de PR / journal d'audit (§11.2)
RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
# Secret attendu par /api/v1/cron/maintenance (Vercel Cron : Authorization: Bearer …)
CRON_SECRET=

# ─── Emails transactionnels (Resend) ────────────────────
# Vérification d'email, mot de passe oublié, invitations. Sans clé : les emails
# sont affichés dans les logs en développement, et non envoyés en production.
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié chez Resend (onboarding@resend.dev = tests uniquement)
EMAIL_FROM="CodeGate <no-reply@votre-domaine.fr>"
